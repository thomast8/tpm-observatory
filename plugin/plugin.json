{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tpm-observatory",
  "version": "1.0.5",
  "description": "Passively track observed Codex model throughput in a local dashboard.",
  "author": {
    "name": "Thomas Tiotto",
    "url": "https://github.com/thomast8"
  },
  "homepage": "https://github.com/thomast8/tpm-observatory",
  "repository": "https://github.com/thomast8/tpm-observatory",
  "license": "MIT",
  "keywords": [
    "codex",
    "telemetry",
    "throughput",
    "tpm",
    "tps"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "interface": {
        "displayName": "Am I Being Throttled?",
        "shortDescription": "Track Codex model throughput automatically.",
        "longDescription": "Passively record completed Codex turns and compare averages, 95% confidence intervals, minima and maxima by model and speed tier in a local dashboard.",
        "developerName": "Thomas Tiotto",
        "category": "Developer tools",
        "websiteURL": "https://github.com/thomast8/tpm-observatory",
        "defaultPrompt": [
          "Open the Am I Being Throttled? dashboard."
        ],
        "logo": "./assets/tpm-observatory.svg",
        "composerIcon": "./assets/tpm-observatory.svg"
      }
    }
  }
}
